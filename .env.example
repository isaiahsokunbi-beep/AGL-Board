# Environment variables

BOARD_PASSPHRASE=your-shared-passphrase

# Annotations: api (shared via Supabase) | local (this browser only) | supabase (direct client)
NEXT_PUBLIC_ANNOTATION_STORE=api

# Supabase — required for shared comments (api or supabase mode)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer service role on the server (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if service role is unavailable (pair with open RLS — not recommended)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
